      "fields": {
        "url": "vogataya-generating-station-completed-installation-of-the-cryostat-lid",
        "header": "Vogataya Generating Station Completed Installation of the Cryostat Lid",
        "subheader": "The installation of the cryostat lid marks a significant milestone in the station's operational capabilities.",
        "created": "2026-04-22T00:00+07:00",
        "newscontent": {
          "nodeType": "document",
          "data": {},
          "content": [
            {
              "nodeType": "paragraph",
              "data": {},
              "content": [
                {
                  "nodeType": "text",
                  "value": "On 22 April, 2026, Vogataya Generating Station successfully completed the installation of the cryostat lid, a critical component in the station's nuclear reactor system. This achievement represents a major milestone in the station's operational capabilities and underscores the commitment to maintaining the highest standards of safety and efficiency.",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "paragraph",
              "data": {},
              "content": [
                {
                  "nodeType": "text",
                  "value": "With the help from ",
                  "marks": [],
                  "data": {}
                },
                {
                  "nodeType": "hyperlink",
                  "data": {
                    "uri": "https://www.ciemat.es/en/introduccion"
                  },
                  "content": [
                    {
                      "nodeType": "text",
                      "value": "CIEMAT",
                      "marks": [],
                      "data": {}
                    }
                  ]
                },
                {
                  "nodeType": "text",
                  "value": ", the assembled cryostat lid was carefully positioned and secured, ensuring optimal performance and safety for the reactor. The cryostat lid serves as a crucial barrier, maintaining the integrity of the reactor's internal environment and supporting the overall efficiency of the power generation process.",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "embedded-asset-block",
              "data": {
                "target": {
                  "sys": {
                    "id": "DSbiYaEhx527OsOf0NvsD",
                    "type": "Link",
                    "linkType": "Asset"
                  }
                }
              },
              "content": []
            },
            {
              "nodeType": "paragraph",
              "data": {},
              "content": [
                {
                  "nodeType": "text",
                  "value": "A 3D render of the cryostat lid, placed in the biological shield.",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ],
                  "data": {}
                }
              ]
            }
          ]
        }
      }
    },
